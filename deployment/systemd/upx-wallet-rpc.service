[Unit]
Description=uPlexa pool wallet (uplexa-wallet-rpc, 127.0.0.1:41062, --disable-rpc-login: local use only)
After=upx-node.service
Requires=upx-node.service

[Service]
Type=simple
User=upxpool
ExecStart=/opt/upx/bin/uplexa-wallet-rpc --wallet-file /opt/upx/wallet/pool.wallet --password-file /opt/upx/wallet/password --rpc-bind-ip 127.0.0.1 --rpc-bind-port 41062 --disable-rpc-login --daemon-address 127.0.0.1:21061 --trusted-daemon --log-file /opt/upx/wallet/wallet-rpc.log --max-log-file-size 0
Restart=on-failure
RestartSec=15
LimitNOFILE=65536
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
