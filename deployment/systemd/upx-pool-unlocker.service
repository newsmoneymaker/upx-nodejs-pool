[Unit]
Description=uPlexa pool: block unlocker (credits the miners after the coinbase maturity)
After=upx-pool-redis.service upx-node.service upx-wallet-rpc.service
Requires=upx-pool-redis.service
[Service]
Type=simple
User=upxpool
WorkingDirectory=/opt/upx-nodejs-pool
ExecStart=/usr/bin/node /opt/upx-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
