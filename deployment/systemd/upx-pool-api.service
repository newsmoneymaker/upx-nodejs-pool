[Unit]
Description=uPlexa pool: public API (127.0.0.1:8118)
After=upx-pool-redis.service upx-node.service upx-wallet-rpc.service
Requires=upx-pool-redis.service
[Service]
Type=simple
User=upxpool
WorkingDirectory=/opt/upx-nodejs-pool
ExecStart=/usr/bin/node /opt/upx-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
