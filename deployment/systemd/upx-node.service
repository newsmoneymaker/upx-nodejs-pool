[Unit]
Description=uPlexa node (uplexad)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=upxpool
ExecStart=/opt/upx/bin/uplexad --data-dir /opt/upx/data --non-interactive --rpc-bind-ip 127.0.0.1 --rpc-bind-port 21061 --p2p-bind-port 21060 --log-level 1 --max-log-file-size 0
Restart=on-failure
RestartSec=15
LimitNOFILE=65536
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
